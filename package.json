{
  "name": "@jvpdls/seo-tools",
  "version": "0.1.1",
  "description": "Type-safe SEO utilities for JavaScript and TypeScript: slugs, SERP meta, headings, keyword density, URL normalization, UTM builder, and HTML link analysis. Zero dependencies, ESM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/domains/text/index.d.ts",
      "import": "./dist/domains/text/index.js"
    },
    "./headings": {
      "types": "./dist/domains/headings/index.d.ts",
      "import": "./dist/domains/headings/index.js"
    },
    "./url": {
      "types": "./dist/domains/url/index.d.ts",
      "import": "./dist/domains/url/index.js"
    },
    "./serp": {
      "types": "./dist/domains/serp/index.d.ts",
      "import": "./dist/domains/serp/index.js"
    },
    "./html": {
      "types": "./dist/domains/html/index.d.ts",
      "import": "./dist/domains/html/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "seo",
    "seo-tools",
    "seo-utilities",
    "on-page-seo",
    "content-seo",
    "technical-seo",
    "serp",
    "meta-title",
    "meta-description",
    "slug",
    "slugify",
    "permalink",
    "keyword-density",
    "reading-time",
    "headings",
    "heading-structure",
    "url-normalize",
    "canonical-url",
    "utm",
    "utm-builder",
    "tracking-params",
    "html-cleaner",
    "link-analysis",
    "internal-links",
    "cms",
    "content-editor",
    "typescript",
    "javascript",
    "esm",
    "tree-shakeable",
    "zero-dependencies"
  ],
  "author": "João Santos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jvpdls/seo-tools.git"
  },
  "bugs": {
    "url": "https://github.com/jvpdls/seo-tools/issues"
  },
  "homepage": "https://github.com/jvpdls/seo-tools#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
